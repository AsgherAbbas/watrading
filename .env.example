# Local development only. Do not enter actual secrets in chat or commit them.
WHATSAPP_ENABLED=false
# Set privately before launching the server; 32+ random bytes, no default.
JWT_SECRET=
# Exact operator-approved addresses; no public signup exists.
ADMIN_EMAILS=
APP_ALLOWED_EMAILS=
# MongoDB is mandatory; selections and application records are durable.
MONGO_URI=
# Mandatory explicit database; a URI path never selects it for this app.
MONGODB_DB_NAME=wa_trading_staging
# Default 8 hours, allowed 900–28800 seconds; no refresh or 30-day tokens.
AUTH_SESSION_TTL_SECONDS=28800
# Empty means trust only the direct peer, ignoring forwarded headers.
# Set only verified reverse-proxy IP/CIDR ranges; never use true or a hop count.
TRUST_PROXY_CIDRS=
# Keep these empty for disconnected development.
WEBHOOK_SECRET=
WHAPI_TOKENS_JSON={}
CLAUDE_API_KEY=
PORT=3000

# All external AI features are independently OFF. Legacy AI_ENABLED is ignored.
# No default/fallback model. Configure an operator-reviewed available Anthropic
# Claude model ID; syntax is validated, availability must be verified separately.
# Retired claude-sonnet-4-20250514 is explicitly rejected. Never enter real keys here.
ANTHROPIC_MODEL=
# Set each approval ONLY after explicit approval for these data and Anthropic.
# Selecting a source, authenticating, or enabling a feature is NOT sharing approval.
# Price sends numerical counts/price summaries/buckets/trends and closed enums.
# Series have anonymous generated labels. No product/spec free text, source/contact/
# group identifiers, individual evidence, source messages, or user text is sent.
AI_PRICE_EXPLANATION_ENABLED=false
AI_PRICE_AGGREGATES_TO_ANTHROPIC_APPROVED=false
# Briefing sends captured counts, top product model strings and up to 15 listing
# samples (type/model/price/currency/seller country), which may contain source text.
AI_BRIEFING_ENABLED=false
AI_BRIEFING_TO_ANTHROPIC_APPROVED=false
# Profile sends the trader query (potentially identity/phone) plus selected matching
# listing type, condition, model, grade, price, currency and seller country strings.
AI_PROFILE_ENABLED=false
AI_PROFILE_TO_ANTHROPIC_APPROVED=false
# Autoreply sends one canonical selected listing's type/condition/model/storage/
# grade/price/currency, sender identity/country and the user's reply-intent text.
AI_AUTOREPLY_ENABLED=false
AI_AUTOREPLY_TO_ANTHROPIC_APPROVED=false
# Item sends the user's full question text; approval must cover its actual content.
AI_ITEM_ENABLED=false
AI_ITEM_TO_ANTHROPIC_APPROVED=false
# Eligible new leads must have messages within this window (1–168 hours).
MATCH_FRESHNESS_HOURS=48
